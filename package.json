{
  "name": "quizlab-pwa",
  "version": "2.3.4",
  "private": true,
  "type": "module",
  "description": "Ứng dụng quiz tiếng Việt trên web, JavaScript thuần và IndexedDB",
  "scripts": {
    "start": "node scripts/serve.mjs",
    "test": "node --test tests/*.test.js",
    "test:browser": "node tests/browser.mjs",
    "test:admin": "python3 -m unittest discover -s tools/bank -p 'test_*.py'",
    "bank:import": "python3 tools/bank/convert.py",
    "bank:validate": "node scripts/validate-bank.mjs",
    "build": "node scripts/build.mjs"
  },
  "engines": { "node": ">=22" }
}
